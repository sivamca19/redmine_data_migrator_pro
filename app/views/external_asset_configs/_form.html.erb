<%= content_for :header_tags do %>
  <%= stylesheet_link_tag 'external_asset_configs', plugin: 'redmine_data_migrator_pro' %>
  <%= javascript_include_tag 'external_asset_configs', plugin: 'redmine_data_migrator_pro' %>
<% end %>

<%= error_messages_for @config %>

<div class="box tabular" data-config-mode="<%= @config.persisted? ? 'edit' : 'new' %>">
  <fieldset>
    <legend>Basic Information</legend>

    <p>
      <%= f.label :name, 'Configuration Name *', class: 'required' %>
      <%= f.text_field :name, required: true, size: 40,
                       placeholder: 'e.g., Main JIRA Instance' %>
      <em class="info">Unique name to identify this configuration</em>
    </p>

    <p>
      <%= f.label :system_type, 'System Type *', class: 'required' %>
      <%= f.select :system_type,
                   options_for_select(
                     ExternalAssetConfig::SUPPORTED_SYSTEMS.map { |sys| [sys.humanize, sys] },
                     @config.system_type
                   ),
                   { prompt: 'Select system type...' },
                   { required: true, class: 'system-type-selector' } %>
    </p>

    <p>
      <%= f.label :project_id, 'Associated Project' %>
      <%= f.select :project_id,
                   options_from_collection_for_select(@projects, :id, :name, @config.project_id),
                   { prompt: 'All Projects (Global Configuration)' },
                   { class: 'project-selector' } %>
      <em class="info">Leave blank to make this configuration available for all projects</em>
    </p>

    <p>
      <%= f.label :base_url, 'Base URL *', class: 'required' %>
      <%= f.text_field :base_url, required: true, size: 60,
                       placeholder: 'https://your-instance.atlassian.net' %>
      <em class="info">Full URL including protocol (https://)</em>
    </p>

    <p>
      <%= f.label :status, 'Status' %>
      <%= f.select :status,
                   options_for_select(
                     ExternalAssetConfig::STATUSES.map { |status| [status.humanize, status] },
                     @config.status
                   ),
                   {},
                   { class: 'status-selector' } %>
    </p>

    <p>
      <%= f.label :description, 'Description' %>
      <%= f.text_area :description, rows: 3, cols: 60,
                      placeholder: 'Optional description of this configuration...' %>
    </p>
  </fieldset>

  <fieldset class="credentials-section">
    <legend>Authentication Credentials</legend>
    <div class="credentials-info">
      <p class="info-text">
        Configure authentication credentials for accessing the external system.
        These credentials are encrypted and stored securely.
      </p>
    </div>

    <div class="system-specific-fields">
      <!-- JIRA Fields -->
      <div class="jira-fields credential-fields" style="<%= @config.system_type == 'jira' ? 'display: block;' : 'display: none;' %>">
        <p>
          <%= f.label :email, 'Email Address *' %>
          <%= f.email_field :email, size: 40,
                            placeholder: 'your-email@domain.com',
                            value: @config.persisted? ? (@config.email || '[Configured]') : '' %>
          <em class="info">JIRA user email address</em>
        </p>

        <p>
          <%= f.label :api_token, 'API Token *' %>
          <%= f.password_field :api_token, size: 40,
                              placeholder: @config.persisted? ? 'Leave blank to keep existing' : 'Your JIRA API token' %>
          <em class="info">
            <% if @config.persisted? %>
              Leave blank to keep existing token, or enter new token to replace.
            <% end %>
            Generate from
            <a href="https://id.atlassian.com/manage-profile/security/api-tokens" target="_blank">
              Atlassian Account Settings
            </a>
          </em>
        </p>
      </div>

      <!-- ClickUp Fields -->
      <div class="clickup-fields credential-fields" style="<%= @config.system_type == 'clickup' ? 'display: block;' : 'display: none;' %>">
        <% if @config.system_type == 'clickup' %>
          <p>
            <%= f.label :api_key, 'API Key *' %>
            <%= f.password_field :api_key, size: 50,
                                placeholder: @config.persisted? ? 'Leave blank to keep existing' : 'pk_your_api_key_here' %>
            <em class="info">
              <% if @config.persisted? %>Leave blank to keep existing key. <% end %>
              Generate from ClickUp Settings > Apps > API
            </em>
          </p>
        <% end %>
      </div>

      <!-- Asana Fields -->
      <div class="asana-fields credential-fields" style="<%= @config.system_type == 'asana' ? 'display: block;' : 'display: none;' %>">
        <% if @config.system_type == 'asana' %>
          <p>
            <%= f.label :api_token, 'Personal Access Token *' %>
            <%= f.password_field :api_token, size: 50,
                                placeholder: @config.persisted? ? 'Leave blank to keep existing' : 'Your Asana personal access token' %>
            <em class="info">
              <% if @config.persisted? %>Leave blank to keep existing token. <% end %>
              Generate from Asana Developer Console
            </em>
          </p>
        <% end %>
      </div>

      <!-- Trello Fields -->
      <div class="trello-fields credential-fields" style="<%= @config.system_type == 'trello' ? 'display: block;' : 'display: none;' %>">
        <% if @config.system_type == 'trello' %>
          <p>
            <%= f.label :api_key, 'API Key *' %>
            <%= f.text_field :api_key, size: 50,
                             placeholder: @config.persisted? ? 'Leave blank to keep existing' : 'Your Trello API key',
                             value: @config.persisted? ? (@config.api_key || '[Configured]') : '' %>
          </p>

          <p>
            <%= f.label :api_token, 'API Token *' %>
            <%= f.password_field :api_token, size: 50,
                                placeholder: @config.persisted? ? 'Leave blank to keep existing' : 'Your Trello API token' %>
            <% if @config.persisted? %><em class="info">Leave blank to keep existing token</em><% end %>
          </p>
        <% end %>
      </div>

      <!-- Monday Fields -->
      <div class="monday-fields credential-fields" style="<%= @config.system_type == 'monday' ? 'display: block;' : 'display: none;' %>">
        <% if @config.system_type == 'monday' %>
          <p>
            <%= f.label :api_key, 'API Token *' %>
            <%= f.password_field :api_key, size: 50,
                                placeholder: @config.persisted? ? 'Leave blank to keep existing' : 'Your Monday.com API token' %>
            <em class="info">
              <% if @config.persisted? %>Leave blank to keep existing token. <% end %>
              Generate from Monday.com API settings
            </em>
          </p>
        <% end %>
      </div>
    </div>

    <% if @config.persisted? && @config.credentials_configured? %>
      <div class="test-connection-section">
        <p>
          <%= link_to 'Test Connection',
                      test_connection_external_asset_config_path(@config),
                      remote: true,
                      class: 'button test-connection-btn',
                      data: { config_id: @config.id } %>
          <span class="test-connection-result"></span>
        </p>
      </div>
    <% end %>
  </fieldset>

  <fieldset class="advanced-section" style="display: none;">
    <legend>Advanced Settings</legend>

    <p>
      <%= f.label :team_id, 'Team/Organization ID' %>
      <%= f.text_field :team_id, size: 30,
                       placeholder: 'Optional team or organization ID' %>
      <em class="info">Required for some multi-tenant systems</em>
    </p>

    <p>
      <%= f.label :additional_config, 'Additional Configuration' %>
      <%= f.text_area :additional_config, rows: 4, cols: 60,
                      placeholder: 'JSON format additional configuration options' %>
      <em class="info">Advanced configuration in JSON format</em>
    </p>
  </fieldset>

  <p>
    <a href="#" class="toggle-advanced">Show Advanced Settings</a>
  </p>
</div>