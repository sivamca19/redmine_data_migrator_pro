<%= render_breadcrumbs(@config, 'edit') %>

<h2>Edit Configuration: <%= @config.name %></h2>

<%= form_with model: @config, local: true, html: { class: 'tabular' } do |f| %>
  <%= render 'form', f: f %>

  <p>
    <%= f.submit 'Update Configuration', class: 'button-positive' %>
    <%= link_to 'Cancel', external_asset_configs_path, class: 'button' %>
    <%= link_to 'View', external_asset_config_path(@config), class: 'button' %>
  </p>
<% end %>